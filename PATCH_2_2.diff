+// Synthetic performance probe; it never opens IndexedDB or real FinRate data.
+// Run with: node tools/benchmark-validation.mjs
+import {performance} from 'node:perf_hooks';
+import {newDocument,addAccount,addCategory,validateDocument} from '../src/model.mjs';
+function fixture(count){
+  const d=newDocument();
+  addAccount(d,{id:'a',name:'Синтетический счёт',opening:100000});
+  addCategory(d,{id:'c',name:'Синтетическая категория'});
+  const expenses=Math.ceil(count*2/3);
+  for(let i=0;i<expenses;i++)d.operations.push({
+    id:'expense-'+i,kind:'expense',date:'2026-10-14',accountId:'a',
+    amount:100000,allocations:[{categoryId:'c',amount:100000}],note:''
+  });
+  for(let i=0;i<count-expenses;i++)d.operations.push({
+    id:'refund-'+i,kind:'refund',date:'2026-10-14',
+    accountId:'a',referenceId:'expense-'+i,amount:1,
+    allocations:[{categoryId:'c',amount:1}],note:''
+  });
+  return d;
+}
+for(const count of [1000,5000,15000]){
+  const doc=fixture(count),samples=[];
+  for(let i=0;i<5;i++){
+    const start=performance.now();validateDocument(doc);
+    samples.push(performance.now()-start);
+  }
+  samples.sort((a,b)=>a-b);
+  console.log(JSON.stringify({count,medianMilliseconds:+samples[2].toFixed(2)}));
+}
