+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {newDocument,addAccount,addCategory,post,validateDocument,changed,totals} from '../src/model.mjs';
+
+function fixture() {
+  const d=newDocument();
+  addAccount(d,{id:'a',name:'Тестовый счёт',opening:1000000});
+  addCategory(d,{id:'food',name:'Покупки'});
+  addCategory(d,{id:'travel',name:'Поездки'});
+  return d;
+}
+const expense=(id,amount=1000,categoryId='food')=>({
+  id,kind:'expense',date:'2026-10-14',accountId:'a',amount,
+  allocations:[{categoryId,amount}],referenceId:null,note:''
+});
+const refund=(id,referenceId,amount=100,categoryId='food')=>({
+  id,kind:'refund',date:'2026-10-14',accountId:'a',amount,
+  allocations:[{categoryId,amount}],referenceId,note:''
+});
+function expectCode(fn,code){assert.throws(fn,e=>e.code===code);}
+
+test('independent refunds remain bounded by their own purchase',()=>{
+  const d=fixture();
+  post(d,expense('e1',500));post(d,expense('e2',700,'travel'));
+  post(d,refund('r1','e1',200));
+  post(d,refund('r2','e1',300));
+  post(d,refund('r3','e2',600,'travel'));
+  validateDocument(d);
+  assert.equal(totals(d).expense,100);
+  expectCode(()=>post(d,refund('excess','e1',1)),'REFUND');
+  expectCode(()=>post(d,refund('excess2','e2',101,'travel')),'REFUND');
+  assert.equal(d.operations.length,5);
+});
+
+test('validation is independent of storage order for historical refunds',()=>{
+  const d=fixture();
+  d.operations=[refund('r1','e',400),expense('e',1000),refund('r2','e',600)];
+  assert.equal(validateDocument(d),d);
+  d.operations.push(refund('r3','e',1));
+  expectCode(()=>validateDocument(d),'REFUND');
+});
+
+test('cancelled refund does not reduce available refund cap',()=>{
+  const d=fixture();
+  d.operations=[expense('e',1000),{...refund('r1','e',900),cancelled:true},refund('r2','e',1000)];
+  validateDocument(d);
+  d.operations[1].cancelled=false;
+  expectCode(()=>validateDocument(d),'REFUND');
+});
+
+test('cancelled original blocks active refund but not a cancelled historical refund',()=>{
+  const d=fixture();
+  d.operations=[{...expense('e',1000),cancelled:true},{...refund('r','e',100),cancelled:true}];
+  validateDocument(d);
+  d.operations[1].cancelled=false;
+  expectCode(()=>validateDocument(d),'REFUND');
+});
+
+test('historical archive and split category caps are preserved',()=>{
+  const d=fixture();
+  d.operations=[{
+    ...expense('e',1000),allocations:[{categoryId:'food',amount:600},{categoryId:'travel',amount:400}]
+  }, refund('r1','e',500),refund('r2','e',400,'travel')];
+  d.categories[0].archived=true;
+  validateDocument(d);
+  d.operations.push(refund('r3','e',101));
+  expectCode(()=>validateDocument(d),'REFUND');
+});
+
+test('many refunds of one purchase use exact integer caps and do not alter document schema',()=>{
+  const d=fixture();
+  d.operations.push(expense('original',10000));
+  for(let i=0;i<2000;i++)d.operations.push(refund('refund-'+i,'original',5));
+  validateDocument(d);
+  assert.equal(d.schema,3);
+  assert.equal(d.operations.length,2001);
+  d.operations.push(refund('extra','original',1));
+  expectCode(()=>validateDocument(d),'REFUND');
+  d.operations.pop();
+  changed(d,'test.validation');
+  assert.equal(d.revision,1);
+});
