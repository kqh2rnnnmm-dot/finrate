+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFile} from 'node:fs/promises';
+const read=name=>readFile(new URL('../src/'+name,import.meta.url),'utf8');
+
+test('authentication uses explicit forms instead of modifying legacy HTML',async()=>{
+  const app=await read('app.mjs');
+  assert.match(app,/function auth\(\)/);
+  assert.match(app,/const authForm=exists/);
+  assert.match(app,/id="unlock"/);
+  assert.match(app,/id="setup"/);
+  assert.doesNotMatch(app,/legacyAuth/);
+  assert.doesNotMatch(app,/\.replace\(\/<label>/);
+});
+
+test('first account remains an explicit zero-opening domain default',async()=>{
+  const app=await read('app.mjs'),service=await read('service.mjs');
+  assert.match(app,/app\.setup\(v\)/);
+  assert.match(service,/addAccount\(d,\{name:name\|\|'Основной счёт',kind:kind\|\|'wallet',opening:opening\|\|0\}\)/);
+});
+
+test('category restore warning describes existing group restore behavior',async()=>{
+  const management=await read('management.mjs');
+  assert.match(management,/Восстановление основной категории также активирует все её подкатегории/);
+  assert.match(management,/id="cat-restore"/);
+});
+
+test('mobile primary dock never hides inactive labels in the final CSS rule',async()=>{
+  const css=await read('style.css');
+  const qualitySection=css.slice(css.indexOf('Quality pass 2.2:'));
+  assert.match(qualitySection,/\.bottom \.nav-label,\.bottom button\.active \.nav-label/);
+  assert.match(qualitySection,/display:block/);
+  assert.match(qualitySection,/--dock-reserve:calc\(7rem/);
+});
